  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "set \"CAPACITOR_BUILD=true\" && if not defined VITE_API_BASE_URL set \"VITE_API_BASE_URL=http://10.0.2.2:3000/api\" && npm run build && npx cap sync android",
